# ════════════════════════════════════════════════════════
# ONEX Points — Variables de entorno (configurar en Vercel)
# Dashboard → Proyecto math-rush-arena → Settings → Environment Variables
# ════════════════════════════════════════════════════════

# PIN del panel de staff (/staff.html). Elige 4-8 dígitos. NUNCA en el código.
STAFF_PIN=cambiar-por-tu-pin

# Secreto para firmar tokens de sesión. Genera uno largo y aleatorio, ej:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambiar-por-secreto-aleatorio-largo

# Upstash Redis — se crean SOLOS al conectar la integración desde Vercel:
# Dashboard → Storage → Create Database → Upstash (Redis) → Connect to project
# (la integración inyecta UPSTASH_REDIS_REST_URL y UPSTASH_REDIS_REST_TOKEN,
#  o KV_REST_API_URL / KV_REST_API_TOKEN — el código acepta ambos nombres)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
